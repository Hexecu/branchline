# Copy this file outside the repository before adding real credentials.
# Placeholder keys are intentionally ignored by the importer.
# No value is evaluated as shell code or expanded from the environment.

# LiteLLM gateway. Replace the example domain and key with your own.
LITELLM_ENDPOINT=https://gateway.example.invalid/v1
LITELLM_KEY=your-litellm-key
LITELLM_MODEL=gemini-3.5-flash

# OpenAI. Use the exact model ID available to your account.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=

# Azure OpenAI. The model field is your deployment name, not a catalog model ID.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT=
# Leave blank for /openai/v1; a dated version selects the deployment REST API.
AZURE_OPENAI_API_VERSION=

# Gemini through Google AI Studio.
GEMINI_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash

# Vertex AI through already-configured Google Application Default Credentials.
# Replace the project value. Do not add GOOGLE_APPLICATION_CREDENTIALS unless
# you explicitly want to import the referenced local service-account JSON.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash

# Bedrock through an existing local AWS profile. Replace the profile name and
# set an exact model ID or inference profile ID/ARN available in this region.
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile
BEDROCK_MODEL=
# Alternative credential modes (uncomment and replace only the mode you use):
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token

# Local Ollama; keep the model blank until discovery confirms what is installed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
